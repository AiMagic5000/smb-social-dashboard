{
  "name": "SMB Social - Image Generator & GitHub Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-social-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.run/fal-ai/flux/dev",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Key {{ $env.FAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.prompt }}\",\n  \"image_size\": \"{{ $json.platform === 'instagram' ? 'square_hd' : 'portrait_16_9' }}\",\n  \"num_inference_steps\": 28,\n  \"guidance_scale\": 3.5\n}",
        "options": {}
      },
      "id": "fal-ai-generate",
      "name": "Generate Image (fal.ai)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.images[0].url }}",
        "options": {}
      },
      "id": "download-image",
      "name": "Download Generated Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Generate filename and prepare for GitHub upload\nconst postId = $('Webhook Trigger').item.json.postId;\nconst platform = $('Webhook Trigger').item.json.platform;\nconst date = new Date().toISOString().split('T')[0];\nconst filename = `${platform}/${date}-${postId}.png`;\n\n// Get the binary data\nconst binaryData = $input.item.binary.data;\n\nreturn {\n  filename,\n  postId,\n  platform,\n  date,\n  contentBase64: binaryData.data,\n  mimeType: binaryData.mimeType\n};"
      },
      "id": "prepare-upload",
      "name": "Prepare for GitHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/AiMagic5000/smb-social-images/contents/{{ $json.filename }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "token {{ $env.GITHUB_TOKEN }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"Add image for post {{ $json.postId }}\",\n  \"content\": \"{{ $json.contentBase64 }}\"\n}",
        "options": {}
      },
      "id": "upload-to-github",
      "name": "Upload to GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "jsCode": "// Construct the raw GitHub URL for the image\nconst filename = $('Prepare for GitHub').item.json.filename;\nconst postId = $('Prepare for GitHub').item.json.postId;\nconst imageUrl = `https://raw.githubusercontent.com/AiMagic5000/smb-social-images/main/${filename}`;\n\nreturn {\n  success: true,\n  postId,\n  imageUrl,\n  uploadedAt: new Date().toISOString()\n};"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1540, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Generate Image (fal.ai)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Image (fal.ai)": {
      "main": [
        [
          {
            "node": "Download Generated Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Generated Image": {
      "main": [
        [
          {
            "node": "Prepare for GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare for GitHub": {
      "main": [
        [
          {
            "node": "Upload to GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to GitHub": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
